{
  "opencollection": "1.0.0",
  "info": {
    "name": "Configure8 Public REST Catalog Entities Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenant}.configure8.io/public/v1/users",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "role",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve users"
        },
        {
          "info": {
            "name": "Modify a user",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenant}.configure8.io/public/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Modify a user"
        },
        {
          "info": {
            "name": "Remove a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenant}.configure8.io/public/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove a user"
        }
      ]
    }
  ],
  "bundled": true
}